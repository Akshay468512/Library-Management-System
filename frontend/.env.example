# Smart College Library — Environment Configuration
# Copy this file to `.env` and populate with your local values.
# Never commit `.env` to version control.

# ── Firebase Web SDK (Firebase Console → Project Settings → Web app) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — Google Analytics measurement ID
VITE_FIREBASE_MEASUREMENT_ID=

# ── API Tier ──
# Base URL for the Flask logic tier (default: local development)
VITE_API_BASE=http://127.0.0.1:5000
